# Copy to .env and fill in. .env is git-ignored; never commit a key.
# With nothing set, everything runs offline on the scripted backend, with no key and no network.

# One of: scripted, openai, anthropic, kimi, openrouter, deepseek, qwen, mistral, groq, ollama, custom
LLM_PROVIDER=scripted

# Any model id your provider offers. Required for every provider except scripted.
LLM_MODEL=

# The key. A vendor's usual variable works too (OPENAI_API_KEY, ANTHROPIC_API_KEY, MOONSHOT_API_KEY,
# OPENROUTER_API_KEY, DEEPSEEK_API_KEY, DASHSCOPE_API_KEY, MISTRAL_API_KEY, GROQ_API_KEY).
LLM_API_KEY=

# Optional: override the preset URL. Required for LLM_PROVIDER=custom.
# LLM_BASE_URL=https://your-endpoint.example.com/v1

# Optional: `openai` (default) or `anthropic` wire format, for custom endpoints.
# LLM_PROTOCOL=openai

# Optional: request token limit parameter name. Some endpoints want max_completion_tokens.
# LLM_TOKEN_PARAM=max_tokens

# Optional: leave unset unless your model needs it. Some models reject this parameter.
# LLM_TEMPERATURE=0

# Optional: USD per million tokens, so the cost limit can work. Unset means cost reads as zero,
# and only the call and token limits apply.
# LLM_PRICE_IN_PER_MTOK=3.00
# LLM_PRICE_OUT_PER_MTOK=15.00

# Optional: give one role its own model or vendor by adding _<ROLE>. Using a different model for the
# reviewer makes its check more independent of the writer.
# LLM_PROVIDER_REVIEWER=anthropic
# LLM_MODEL_REVIEWER=
# LLM_API_KEY_REVIEWER=
